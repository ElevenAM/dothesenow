# ============================================================================
# DoTheseNow MCP Server — Environment Variables
# ============================================================================

# Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key (Settings → API → service_role)
# Full database access — never expose publicly
SUPABASE_SERVICE_ROLE_KEY=eyJhb...your-service-role-key

# Organization ID — the org this MCP instance operates on
# Can also be passed per-request via tool parameters
ORG_ID=your-org-uuid
